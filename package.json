{
  "name": "pizza-zap",
  "description": "",
  "version": "1.0.0",
  "main": "index.js",
  "license": "ISC",
  "type": "module",
  "private": true,
  "author": {
    "name": "Erivelton Silva",
    "email": "erivelton.silva@gmail.com"
  },
  "scripts": {
    "build": "tsup",
    "start": "node --env-file=.env dist/index.cjs",
    "dev": "tsx --env-file=.env src/index.ts",
    "husky:pre-commit": "tsc --noEmit && biome format --write --staged ./src && biome lint --write --staged ./src && git add .",
    "husky:pre-push": "",
    "clean": "rm -rf dist",
    "fmt": "biome format --staged ./src",
    "lint": "biome lint ./src",
    "check": "biome check --fix --unsafe --verbose ./src",
    "check:types": "tsc --noEmit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.15.21",
    "husky": "^9.1.7",
    "tsup": "^8.4.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@wppconnect-team/wppconnect": "^1.37.0",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0"
  }
}
